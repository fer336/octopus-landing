---
import '../styles/globals.css';
import '@fontsource-variable/manrope';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import manropeWoff2 from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  structuredData?: object[];
  robots?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  ogImage = '/images/og/og-image-1200x630.jpg',
  canonicalUrl,
  structuredData,
  robots = 'index, follow',
  bodyClass,
} = Astro.props;

const ogImageAbsolute = ogImage.startsWith('http')
  ? ogImage
  : `https://octopustrack.shop${ogImage}`;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-WQVGV3TD');
    </script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <link rel="icon" type="image/x-icon" href="/images/favicon/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/images/favicon/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#7654A8" />

    <!-- Google / Search Engine -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content="OctopusTrack" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OctopusTrack" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:secure_url" content={ogImageAbsolute} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="OctopusTrack ERP para ferreterías, sanitarios y distribuidoras" />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- Self-hosted variable fonts: preload the woff2 the CSS will request first -->
    <link rel="preload" as="font" type="font/woff2" href={manropeWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />

    <!-- Subset of src/styles/globals.css :root, inlined to avoid FOUC before the stylesheet loads.
         Keep numeric values identical to globals.css. -->
    <style is:inline>
      :root {
        --background: 247 247 250; --foreground: 22 20 29;
        --card: 255 255 255; --card-foreground: 22 20 29;
        --primary: 118 84 168; --primary-foreground: 255 255 255;
        --border: 222 216 232;
      }
      body { background-color: rgb(var(--background)); color: rgb(var(--foreground)); }
    </style>

    <!-- Structured Data (JSON-LD) -->
    {
      structuredData?.map((item) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }

  </head>
  <body class={bodyClass}>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-WQVGV3TD"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js');
        });
      }
    </script>
  </body>
</html>
