---
import Icon from './Icon.astro';
import SketchUnderline from './SketchUnderline.astro';

const bullets = [
  'Encontrá productos por código o descripción.',
  'Consultá precio y stock al instante.',
  'Generá cotizaciones, remitos y facturas.',
  'Cobrá sin salir del flujo de venta.',
];
---

<section id="producto" class="lumen relative overflow-hidden bg-background px-4 py-24 sm:px-6 sm:py-32 scroll-mt-24">
  <div class="relative mx-auto w-full max-w-7xl">
    <p class="eyebrow">producto</p>

    <article class="reveal-on-scroll mt-6 grid w-full items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <figure class="lumen-card overflow-hidden p-1">
        <div class="relative aspect-[16/9] w-full overflow-hidden rounded-[16px]">
          <img
            src="/assets/mockup-proceso-ventas-1400.webp"
            alt="Proceso de ventas de OctopusTrack: cotizaciones, remitos, facturas, acopios y cuentas corrientes desde una sola pantalla"
            class="h-full w-full object-cover object-center"
            loading="lazy"
          />
        </div>
      </figure>

      <div class="flex flex-col justify-center">
        <h2 class="font-lumen-display text-3xl leading-[1.08] tracking-tight text-foreground sm:text-4xl lg:text-5xl">
          Todo lo que necesitás para cerrar una venta, en <SketchUnderline underlineOnly onScroll>una sola pantalla</SketchUnderline>
        </h2>
        <ul class="mt-10 space-y-5">
          {bullets.map((line) => (
            <li class="flex items-start gap-3 text-lg leading-relaxed text-muted-foreground sm:text-xl">
              <Icon name="checkCircle" class="mt-1 h-6 w-6 shrink-0 text-primary" />
              <span>{line}</span>
            </li>
          ))}
        </ul>
      </div>
    </article>
  </div>
</section>
