---
import Icon from './Icon.astro';

const rubros = [
  {
    label: 'ferreterías',
    need: 'Stock, presupuestos y cuentas corrientes para vender rápido incluso con catálogos grandes.',
    functions: ['Catálogo amplio con búsqueda rápida', 'Presupuestos y remitos al instante'],
    href: '/industrias/ferreterias',
  },
  {
    label: 'distribuidoras',
    need: 'Rutas, clientes y cobranzas organizadas en un solo sistema.',
    functions: ['Cuentas corrientes por cliente', 'Seguimiento de cobranzas'],
    href: '/industrias/',
  },
  {
    label: 'forrajerías',
    need: 'Venta a granel, bolsas y acopios bajo control.',
    functions: ['Manejo de acopios', 'Precios por volumen'],
    href: '/industrias/',
  },
  {
    label: 'sanitarios',
    need: 'Cuentas corrientes y pedidos claros para catálogos técnicos.',
    functions: ['Cuentas corrientes detalladas', 'Gestión de pedidos'],
    href: '/industrias/sanitarios',
  },
  {
    label: 'electricidad',
    need: 'Presupuestos y materiales organizados para cada obra.',
    functions: ['Presupuestos rápidos', 'Control de materiales'],
    href: '/industrias/electricidad',
  },
];
---

<section id="rubros" class="lumen relative overflow-hidden bg-background px-4 py-16 sm:px-6 sm:py-28 scroll-mt-24">
  <div class="relative mx-auto w-full max-w-6xl">
    <p class="eyebrow">rubros</p>
    <div class="mt-6 max-w-xl">
      <h2 class="font-lumen-display text-3xl leading-[1.05] text-foreground sm:text-4xl">pensado para comercios que necesitan ordenarse</h2>
      <p class="mt-4 text-sm leading-relaxed text-muted-foreground sm:text-base">cada rubro tiene sus reglas. nosotros las conocemos.</p>
    </div>

    <div class="mt-12 grid gap-5 sm:mt-14 sm:grid-cols-2 lg:grid-cols-5">
      {rubros.map((rubro, index) => (
        <article class="reveal-on-scroll lumen-card flex h-full flex-col p-5" style={`--reveal-delay: ${index * 60}ms`}>
          <span class="font-mono text-xs uppercase tracking-[0.08em] text-muted-foreground/50">0{index + 1}</span>
          <h3 class="mt-3 text-base font-medium leading-tight text-foreground">{rubro.label}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{rubro.need}</p>
          <ul class="mt-4 space-y-1.5">
            {rubro.functions.map((fn) => (
              <li class="flex items-start gap-2 text-xs leading-relaxed text-muted-foreground">
                <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-primary/60"></span>
                <span>{fn}</span>
              </li>
            ))}
          </ul>
          <a href={rubro.href} class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-medium text-primary transition-colors hover:text-primary/80">
            ver solución
            <Icon name="arrowRight" class="h-3.5 w-3.5" />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
