---
import Icon from './Icon.astro';

const cards = [
  { icon: 'zap', title: 'Operación rápida', description: 'Buscá productos, cargá ventas y emití comprobantes con pocos pasos.' },
  { icon: 'users', title: 'Fácil de aprender', description: 'Una interfaz clara para que el equipo pueda empezar a usarlo sin largas capacitaciones.' },
  { icon: 'fileText', title: 'Menos ventanas, menos confusión', description: 'Diseñado para evitar pantallas innecesarias que distraen al vendedor.' },
  { icon: 'search', title: 'Ideal para teclado', description: 'Pensado para trabajar rápido, combinando búsqueda ágil, accesos directos y flujo de venta continuo.' },
  { icon: 'timer', title: 'Venta sin fricción', description: 'El sistema acompaña al vendedor en vez de interrumpir la atención al cliente.' },
  { icon: 'barChart', title: 'ERP moderno, lógica de mostrador', description: 'La velocidad de los sistemas tradicionales con funciones actuales de stock, facturación, caja y reportes.' },
];
---

<section id="venta-mostrador" class="relative overflow-hidden bg-background px-4 py-20 sm:px-6 sm:py-28">
  <div class="pointer-events-none absolute right-[-16%] top-[10%] h-[480px] w-[480px] rounded-full bg-primary-500/12 blur-[120px]"></div>
  <div class="section-container relative">
    <div class="mx-auto max-w-3xl text-center reveal-on-scroll">
      <p class="text-sm font-semibold uppercase tracking-[0.28em] text-primary/80">Venta de mostrador</p>
      <h2 class="mt-5 font-display text-3xl font-black leading-[1.05] text-foreground sm:text-4xl lg:text-5xl">
        Pensado para vender rápido por mostrador
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg">
        Cuando un cliente espera, el vendedor no puede perder tiempo navegando pantallas complejas. OctopusTrack combina la velocidad de los sistemas clásicos de mostrador con la potencia de un ERP moderno, en una experiencia clara, ágil y fácil de aprender.
      </p>
    </div>

    <div class="mx-auto mt-14 grid max-w-6xl auto-rows-fr gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map((card, index) => (
        <article class="h-full reveal-on-scroll" style={`--reveal-delay: ${index * 55}ms`}>
          <div class="group relative isolate flex h-full min-h-[210px] flex-col overflow-hidden rounded-2xl border border-border bg-card/70 p-6 shadow-lg shadow-background/30 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:bg-card hover:shadow-2xl hover:shadow-primary/10">
            <span class="pointer-events-none absolute -right-10 -top-10 -z-10 h-28 w-28 rounded-full bg-primary/15 blur-2xl transition-opacity duration-300 group-hover:opacity-100"></span>
            <div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-primary/12 text-primary ring-1 ring-primary/15">
              <Icon name={card.icon} class="h-5 w-5" />
            </div>
            <h3 class="text-lg font-semibold leading-tight text-foreground">{card.title}</h3>
            <p class="mt-auto pt-4 text-sm leading-relaxed text-muted-foreground">{card.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
