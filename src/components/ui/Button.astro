---
import { cn } from '../../lib/utils';

interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'default' | 'sm';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'default',
  href,
  type = 'button',
  class: className,
  ...rest
} = Astro.props as Props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-xl font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background active:scale-[0.98]';

const variants = {
  primary: 'bg-primary text-primary-foreground hover:bg-primary/90',
  secondary:
    'bg-card text-foreground border border-border hover:border-primary/40 hover:text-primary',
  ghost: 'text-muted-foreground hover:text-foreground',
} as const;

const sizes = {
  default: 'px-5 py-2.5 text-sm',
  sm: 'px-3.5 py-2 text-sm',
} as const;

const classes = cn(base, variants[variant], sizes[size], className);
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}
