---
import { cn } from '../../lib/utils';
import Icon from '../Icon.astro';

interface Props {
  src?: string;
  alt?: string;
  chrome?: 'browser' | 'app' | 'none';
  eager?: boolean;
  width?: number;
  height?: number;
  /** Shown only in placeholder mode, i.e. when no src is provided. */
  placeholderLabel?: string;
  class?: string;
}

const {
  src,
  alt = '',
  chrome = 'browser',
  eager = false,
  width,
  height,
  placeholderLabel = 'Vista previa del producto',
  class: className,
} = Astro.props;
---

<div class={cn('overflow-hidden rounded-3xl border border-border bg-card shadow-xl shadow-primary-950/5', className)}>
  {chrome === 'browser' && (
    <div class="grid h-9 grid-cols-[1fr_auto_1fr] items-center gap-2 border-b border-border bg-muted/60 px-3">
      <div class="flex items-center gap-1.5">
        <span class="h-2 w-2 rounded-full bg-border"></span>
        <span class="h-2 w-2 rounded-full bg-border"></span>
        <span class="h-2 w-2 rounded-full bg-border"></span>
      </div>
      <span class="rounded-lg bg-background px-3 py-1 font-mono text-xs text-muted-foreground">app.octopustrack.com</span>
      <div aria-hidden="true" />
    </div>
  )}
  {chrome === 'app' && <div class="h-9 border-b border-border bg-muted/60" />}

  {
    src ? (
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
        class="block h-auto w-full"
      />
    ) : (
      <div class="relative flex aspect-[16/10] w-full items-center justify-center bg-gradient-to-br from-primary-50 to-primary-100">
        <!-- TODO: replace with raw product screenshot (>=1600px, chrome-less) -->
        <div class="flex flex-col items-center gap-3 px-6 text-center">
          <Icon name="barChart" class="h-10 w-10 text-primary/70" />
          <p class="text-sm text-muted-foreground">{placeholderLabel}</p>
        </div>
      </div>
    )
  }
</div>
