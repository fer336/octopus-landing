---
import AnimatedTentacleLogo from './ui/AnimatedTentacleLogo.astro';
import Button from './ui/Button.astro';
import Icon from './Icon.astro';

// NOTE: "Producto" -> #producto is intentionally omitted; that section ships in PR3.
const NAV_ITEMS = [
  { label: 'Funciones', href: '#caracteristicas' },
  { label: 'Rubros', href: '#rubros' },
  { label: 'Demos', href: '#precios' },
  { label: 'Seguridad', href: '/politicas-seguridad' },
];
---

<header class="fixed left-0 right-0 top-0 z-50 h-16 border-b border-border/60 bg-background/80 backdrop-blur-md">
  <div class="mx-auto flex h-full w-full max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="#inicio" class="flex shrink-0 items-center gap-2.5">
      <AnimatedTentacleLogo class="h-9 w-9" alt="OctopusTrack" />
      <span class="font-display text-lg font-bold tracking-tight text-foreground">OctopusTrack</span>
    </a>

    <nav aria-label="Navegación principal" class="hidden items-center gap-7 lg:flex">
      {
        NAV_ITEMS.map((item) => (
          <a href={item.href} class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">
            {item.label}
          </a>
        ))
      }
      <Button href="/acceder" variant="ghost" size="sm">
        Ingresar
      </Button>
    </nav>

    <div class="flex items-center gap-3">
      <Button data-open-demo-modal size="sm" class="hidden sm:inline-flex">
        Probar demo
      </Button>
      <button
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
        class="flex h-10 w-10 items-center justify-center rounded-lg border border-border/70 bg-card/70 text-muted-foreground transition-colors hover:bg-card hover:text-foreground lg:hidden"
      >
        <span data-menu-icon-open><Icon name="menu" class="h-5 w-5" /></span>
        <span data-menu-icon-close class="hidden"><Icon name="x" class="h-5 w-5" /></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" data-mobile-menu class="max-h-0 overflow-hidden border-t border-border/60 bg-background/95 opacity-0 transition-all duration-300 ease-out lg:hidden">
    <nav aria-label="Navegación móvil" class="mx-auto flex w-full max-w-7xl flex-col gap-1 px-4 py-4 sm:px-6">
      {
        NAV_ITEMS.map((item) => (
          <a
            data-mobile-menu-link
            href={item.href}
            class="rounded-xl px-3 py-2.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-card hover:text-foreground"
          >
            {item.label}
          </a>
        ))
      }
      <a
        data-mobile-menu-link
        href="/acceder"
        class="rounded-xl px-3 py-2.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-card hover:text-foreground"
      >
        Ingresar
      </a>
      <a
        data-mobile-menu-link
        href="/octopusflow"
        class="rounded-xl px-3 py-2.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-card hover:text-foreground"
      >
        OctopusFlow
      </a>
      <Button data-open-demo-modal data-mobile-menu-link class="mt-2 w-full">
        Probar demo
      </Button>
    </nav>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const openIcon = document.querySelector<HTMLElement>('[data-menu-icon-open]');
  const closeIcon = document.querySelector<HTMLElement>('[data-menu-icon-close]');

  const isMenuOpen = () => menuToggle?.getAttribute('aria-expanded') === 'true';

  const setMenuOpen = (open: boolean) => {
    menu?.classList.toggle('max-h-[480px]', open);
    menu?.classList.toggle('opacity-100', open);
    menu?.classList.toggle('max-h-0', !open);
    menu?.classList.toggle('opacity-0', !open);
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    menuToggle?.setAttribute('aria-expanded', String(open));
  };

  menuToggle?.addEventListener('click', () => setMenuOpen(!isMenuOpen()));

  document.querySelectorAll<HTMLElement>('[data-mobile-menu-link]').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });
</script>
