---
import { homeFaqItems } from '../data/homeFaq';
---

<section id="preguntas-frecuentes" class="lumen relative overflow-hidden bg-background px-4 py-20 sm:px-6 sm:py-28 scroll-mt-24">
  <div class="relative mx-auto w-full max-w-6xl">
    <div class="reveal-on-scroll mx-auto max-w-3xl text-center">
      <p class="eyebrow justify-center">preguntas frecuentes</p>
      <h2 class="mt-5 font-lumen-display text-3xl leading-[1.05] text-foreground sm:text-4xl lg:text-5xl">
        ERP comercial para mostrador, sin vueltas
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg">
        Respuestas simples para entender si OctopusTrack encaja con tu comercio, tu forma de vender y la operación diaria detrás del mostrador.
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-5xl gap-4">
      {homeFaqItems.map((item, index) => (
        <details class="group reveal-on-scroll lumen-card p-6 open:border-primary/30" style={`--reveal-delay: ${index * 65}ms`}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-5 text-left marker:hidden">
            <span class="text-lg font-medium leading-tight text-foreground sm:text-xl">{item.question}</span>
            <span class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-[10px] border border-border text-primary transition-transform duration-300 group-open:rotate-45">
              <span class="text-2xl font-light leading-none" aria-hidden="true">+</span>
            </span>
          </summary>
          <p class="mt-5 max-w-3xl text-sm leading-relaxed text-muted-foreground sm:text-base">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
