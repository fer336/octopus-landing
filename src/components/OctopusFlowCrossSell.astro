---

<section class="lumen relative overflow-hidden bg-background px-4 py-8 sm:px-6 sm:py-10">
  <div class="reveal-on-scroll lumen-card mx-auto max-w-4xl p-4 sm:p-6">
    <div class="flex flex-col items-center gap-4 text-center sm:flex-row sm:text-left">
      <div class="flex shrink-0 items-center justify-center">
        <img
          src="/images/logos/logo-header1.svg"
          alt="OctopusFlow"
          class="h-10 w-10 rounded-full ring-1 ring-border sm:h-12 sm:w-12"
        />
      </div>
      <div class="flex-1">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-primary mb-0.5">
          octopusflow
        </p>
        <h3 class="text-base font-medium text-foreground sm:text-lg">
          sistema para profesionales independientes
        </h3>
        <p class="mt-1 max-w-lg text-xs leading-relaxed text-muted-foreground sm:text-sm">
          creá presupuestos profesionales, compartilos por WhatsApp al instante y guardá todos tus clientes.
          pensado para electricistas, plomeros, gasistas y más.
        </p>
      </div>
      <a
        href="/octopusflow"
        class="inline-flex shrink-0 items-center gap-1.5 rounded-[10px] bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground transition-colors duration-200 hover:bg-primary/90 sm:text-sm"
      >
        obtener octopusflow
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>
