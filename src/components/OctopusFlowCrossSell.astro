---
---

<section class="relative overflow-hidden bg-background px-4 py-16 sm:px-6 sm:py-20">
  <div class="reveal-on-scroll mx-auto max-w-4xl">
    <div class="overflow-hidden rounded-2xl border border-border/60 bg-card/60 p-6 sm:p-10 lg:p-12">
      <div class="flex flex-col items-center gap-6 text-center sm:flex-row sm:text-left">
        <div class="flex shrink-0 items-center justify-center">
          <img
            src="/images/logos/logo-header1.svg"
            alt="OctopusFlow"
            class="h-16 w-16 rounded-full ring-2 ring-primary/30 sm:h-20 sm:w-20"
          />
        </div>
        <div class="flex-1">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary mb-1">
            OctopusFlow
          </p>
          <h3 class="text-xl font-bold text-foreground sm:text-2xl">
            Sistema para profesionales independientes
          </h3>
          <p class="mt-2 max-w-lg text-sm leading-relaxed text-muted-foreground">
            Creá presupuestos profesionales, compartilos por WhatsApp al instante y guardá todos tus clientes.
            Pensado para electricistas, plomeros, gasistas y más.
          </p>
        </div>
        <a
          href="/octopusflow"
          class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all duration-200 hover:scale-[1.02] hover:bg-primary/90"
        >
          Obtener OctopusFlow
          <!-- ArrowRight icon (lucide) -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
