---
import Icon from './Icon.astro';
import { DEMO_WHATSAPP_URL } from '../lib/contact';
---

<section class="lumen relative overflow-hidden bg-background px-4 py-20 sm:px-6 sm:py-24">
  <div class="reveal-on-scroll relative mx-auto max-w-3xl border-t border-border pt-16 text-center">
    <h2 class="font-lumen-display text-3xl leading-[1.08] tracking-tight text-foreground sm:text-4xl lg:text-[44px]">
      Tu comercio ya es complejo. Tu sistema no tiene por qué serlo.
    </h2>
    <div class="mt-9 flex justify-center">
      <a href={DEMO_WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-[10px] bg-primary px-7 py-3.5 text-sm font-semibold text-primary-foreground transition-colors duration-200 hover:bg-primary/90 active:bg-primary/80 sm:min-w-[200px]">
        solicitar una demo
        <Icon name="arrowRight" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
