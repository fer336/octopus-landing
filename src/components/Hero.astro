---
import Icon from './Icon.astro';
import SketchUnderline from './SketchUnderline.astro';

// Meter-strip bar heights — procedural envelope (sine), not decorative noise.
// Represents no invented metric; it is a measured-instrument motif per Lumen's
// meter-strip discipline. 56 ticks, gaussian-weighted sine so the centre reads taller.
const METER_TICKS = 56;
const meterBars = Array.from({ length: METER_TICKS }, (_, i) => {
  const t = i / (METER_TICKS - 1);
  const centre = Math.exp(-Math.pow((t - 0.5) * 2.4, 2));
  const wave = 0.55 + 0.45 * Math.sin(i * 0.9);
  const height = Math.max(0.14, centre * 0.8 + wave * 0.32);
  return { height: Math.round(height * 100), opacity: Math.round((0.35 + centre * 0.5) * 100) / 100 };
});
---

<section id="inicio" class="lumen relative overflow-hidden bg-background px-4 pb-0 pt-28 sm:px-6 sm:pt-32">
  <div class="lumen-blueprint absolute inset-0" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto grid w-full max-w-[1400px] items-center gap-12 pb-16 sm:pb-20 xl:grid-cols-[0.72fr_1.28fr] xl:gap-8">
    <div class="max-w-xl">
      <p class="eyebrow">erp de mostrador</p>

      <h1 class="hero-display mt-5 font-lumen-display leading-[1.03] tracking-tight text-foreground">
        vendé más rápido.&nbsp;<SketchUnderline>controlá</SketchUnderline>&nbsp;todo tu comercio.
      </h1>

      <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted-foreground sm:text-xl">
        Ventas, stock, facturación ARCA, caja, cuentas corrientes y reportes en un sistema <SketchUnderline wrapSafe>pensado para trabajar rápido desde el mostrador</SketchUnderline>.
      </p>

      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:items-center">
        <button type="button" data-open-demo-modal class="inline-flex items-center justify-center gap-2 rounded-[10px] bg-primary px-6 py-3.5 text-sm font-semibold text-primary-foreground transition-colors duration-200 hover:bg-primary/90 active:bg-primary/80">
          solicitar demo
          <Icon name="arrowRight" class="h-4 w-4" />
        </button>
        <a data-scroll-target="producto" href="#producto" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border px-6 py-3.5 text-sm font-medium text-foreground transition-colors duration-200 hover:bg-card active:bg-secondary">
          ver cómo funciona
        </a>
      </div>

      <p class="mt-6 max-w-lg text-sm leading-relaxed text-muted-foreground">
        sin tarjeta · configuración acompañada · soporte real
      </p>
    </div>

    <div class="relative mx-auto flex w-full max-w-[820px] items-center justify-center gap-3 xl:gap-4">
      <div class="hidden w-[168px] shrink-0 flex-col gap-4 xl:flex" aria-hidden="true">
        <div class="lumen-node-card reveal-on-scroll" style="--reveal-delay: 60ms;">
          <span class="lumen-node-card__icon"><Icon name="receipt" class="h-4 w-4" /></span>
          <div>
            <p class="lumen-node-card__title">venta registrada<Icon name="checkCircle" class="h-3 w-3 text-[oklch(64%_0.10_159)]" /></p>
            <p class="lumen-node-card__meta">#0025917<br />23/05/2025 · 14:32</p>
          </div>
        </div>
        <div class="lumen-node-card reveal-on-scroll" style="--reveal-delay: 160ms;">
          <span class="lumen-node-card__icon"><Icon name="fileText" class="h-4 w-4" /></span>
          <div>
            <p class="lumen-node-card__title">factura arca emitida<Icon name="checkCircle" class="h-3 w-3 text-[oklch(64%_0.10_159)]" /></p>
            <p class="lumen-node-card__meta">CAE: 75123456789012</p>
            <span class="lumen-node-card__badge">cae aprobado</span>
          </div>
        </div>
        <div class="lumen-node-card reveal-on-scroll" style="--reveal-delay: 260ms;">
          <span class="lumen-node-card__icon"><Icon name="users" class="h-4 w-4" /></span>
          <div>
            <p class="lumen-node-card__title">cuenta corriente actualizada<Icon name="checkCircle" class="h-3 w-3 text-[oklch(64%_0.10_159)]" /></p>
            <p class="lumen-node-card__meta">cliente: acme sas<br />saldo actual: $1.250.900</p>
          </div>
        </div>
      </div>

      <figure class="lumen-apparatus" aria-hidden="true">
        <div class="lumen-apparatus__head">
          <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-muted-foreground/70">comprobante</span>
          <span class="lumen-apparatus__dot"></span>
        </div>
        <div class="px-6 pt-4">
          <p class="lumen-apparatus__heading">venta <span class="text-primary">#0025917</span></p>
          <div class="lumen-apparatus__meta">
            <span>23/05/2025 · 14:32:08</span>
            <span>mostrador 1 · juan m.</span>
          </div>
        </div>
        <div class="lumen-apparatus__table">
          <div class="lumen-apparatus__table-head"><span>producto</span><span>cant</span><span>precio</span><span>total</span></div>
          <div class="lumen-apparatus__table-row"><span>auriculares bluetooth x1</span><span>1</span><span>$89.900</span><span>$89.900</span></div>
          <div class="lumen-apparatus__table-row"><span>mouse inalámbrico m2</span><span>1</span><span>$24.500</span><span>$24.500</span></div>
          <div class="lumen-apparatus__table-row"><span>teclado mecánico tkl</span><span>1</span><span>$59.900</span><span>$59.900</span></div>
        </div>
        <div class="lumen-apparatus__row lumen-apparatus__row--sub"><span>subtotal</span><span>$174.300</span></div>
        <div class="lumen-apparatus__row lumen-apparatus__row--sub"><span>iva (21%)</span><span>$36.603</span></div>
        <div class="lumen-apparatus__total">
          <span>total</span>
          <span>$210.903</span>
        </div>
        <div class="px-6 py-3">
          <div class="lumen-apparatus__line lumen-apparatus__line--accent"></div>
        </div>
        <div class="lumen-apparatus__status">
          <Icon name="checkCircle" class="h-4 w-4 shrink-0" />
          <div>
            <p>operación completada</p>
            <p>todos los sistemas actualizados</p>
          </div>
        </div>
      </figure>

      <div class="hidden w-[168px] shrink-0 flex-col gap-4 xl:flex" aria-hidden="true">
        <div class="lumen-node-card reveal-on-scroll" style="--reveal-delay: 110ms;">
          <span class="lumen-node-card__icon"><Icon name="package" class="h-4 w-4" /></span>
          <div>
            <p class="lumen-node-card__title">stock actualizado<Icon name="checkCircle" class="h-3 w-3 text-[oklch(64%_0.10_159)]" /></p>
            <p class="lumen-node-card__meta">auriculares bluetooth x1<br />stock 100 → 99</p>
          </div>
        </div>
        <div class="lumen-node-card reveal-on-scroll" style="--reveal-delay: 210ms;">
          <span class="lumen-node-card__icon"><Icon name="wallet" class="h-4 w-4" /></span>
          <div>
            <p class="lumen-node-card__title">caja impactada<Icon name="checkCircle" class="h-3 w-3 text-[oklch(64%_0.10_159)]" /></p>
            <p class="lumen-node-card__meta">efectivo</p>
            <p class="lumen-node-card__meta lumen-node-card__meta--success">+ $210.903</p>
          </div>
        </div>
        <div class="lumen-node-card reveal-on-scroll" style="--reveal-delay: 310ms;">
          <span class="lumen-node-card__icon"><Icon name="share" class="h-4 w-4" /></span>
          <div>
            <p class="lumen-node-card__title">mercado libre sincronizado<Icon name="checkCircle" class="h-3 w-3 text-[oklch(64%_0.10_159)]" /></p>
            <p class="lumen-node-card__meta">publicación #mla1234567890</p>
            <span class="lumen-node-card__badge">sincronizado</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <aside class="lumen-meter lumen-blueprint relative z-10 mx-auto w-full max-w-none px-4 sm:px-6" aria-label="Alcance de OctopusTrack">
    <p class="lumen-meter__label hidden sm:block">módulos · 06</p>
    <div class="lumen-meter__bars">
      {meterBars.map((bar) => <span style={`height: ${bar.height}%; opacity: ${bar.opacity};`} />)}
    </div>
    <p class="lumen-meter__label hidden sm:block">rubros · 05</p>
  </aside>
</section>

<style>
  .hero-display {
    font-size: var(--text-display);
    max-width: 15ch;
  }
</style>
