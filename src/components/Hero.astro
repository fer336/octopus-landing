---
import Icon from './Icon.astro';
import Button from './ui/Button.astro';
import AppFrame from './ui/AppFrame.astro';

const HERO_CHIPS = [
  { icon: 'search', label: 'Búsqueda rápida', position: '-left-4 top-10' },
  { icon: 'keyboard', label: 'Uso con teclado', position: '-right-4 top-10' },
  { icon: 'package', label: 'Stock actualizado', position: '-left-4 bottom-10' },
  { icon: 'receipt', label: 'Facturación conectada', position: '-right-4 bottom-10' },
] as const;
---

<section id="inicio" class="relative overflow-hidden bg-background px-4 pb-20 pt-20 sm:px-6 sm:pt-24 lg:pb-28">
  <div class="relative mx-auto max-w-7xl">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="animate-fade-in-up font-display text-4xl font-bold tracking-tight text-foreground sm:text-5xl lg:text-6xl">
        El ERP que mantiene rápido tu mostrador
      </h1>
      <p class="animate-fade-in-up-delay-1 mx-auto mt-6 max-w-2xl text-lg text-muted-foreground">
        Vendé, facturá y controlá tu negocio sin ventanas complicadas ni procesos lentos.
      </p>
      <div class="animate-fade-in-up-delay-2 mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button data-open-demo-modal>Probar una venta</Button>
        {/* TODO(PR3): retarget href to #producto once that section ships */}
        <Button variant="secondary" href="#caracteristicas">Ver cómo funciona</Button>
      </div>
    </div>

    <div class="animate-fade-in-up-delay-3 relative mx-auto mt-14 w-full max-w-5xl sm:mt-16">
      <AppFrame chrome="browser" eager placeholderLabel="Pantalla de ventas de OctopusTrack" />

      {
        HERO_CHIPS.map((chip) => (
          <div class={`pointer-events-none absolute z-10 hidden sm:flex ${chip.position}`}>
            <span class="pointer-events-auto inline-flex items-center gap-1.5 rounded-lg border border-border bg-card/95 px-3 py-1.5 text-xs font-medium text-foreground shadow-md">
              <Icon name={chip.icon} class="h-3.5 w-3.5 text-primary" />
              {chip.label}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
