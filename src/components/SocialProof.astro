---
import AnimatedTentacleLogo from './ui/AnimatedTentacleLogo.astro';
import Icon from './Icon.astro';

const rubros = [
  { icon: 'wrench', label: 'Ferreterías', detail: 'Stock y presupuestos al instante' },
  { icon: 'truck', label: 'Distribuidoras', detail: 'Rutas, clientes y cobranzas' },
  { icon: 'wheat', label: 'Forrajerías', detail: 'Granel, bolsas y acopios' },
  { icon: 'droplets', label: 'Sanitarios', detail: 'Cuentas corrientes y pedidos' },
  { icon: 'wallet', label: 'Electricidad', detail: 'Presupuestos y materiales' },
];

const radius = 38;
const positions = rubros.map((_, index) => {
  const angle = -Math.PI / 2 + (2 * Math.PI * index) / rubros.length;
  return { x: 50 + radius * Math.cos(angle), y: 50 + radius * Math.sin(angle) };
});
const starLines = positions.map((from, index) => {
  const to = positions[(index + 2) % positions.length];
  return { x1: from.x, y1: from.y, x2: to.x, y2: to.y };
});
---

<section id="rubros" class="relative overflow-hidden bg-background px-4 py-16 sm:px-6 sm:py-28">
  <div class="pointer-events-none absolute -top-24 left-1/4 h-[480px] w-[700px] rounded-full bg-primary-600/8 blur-[120px]"></div>

  <div class="section-container">
    <div class="reveal-on-scroll mb-12 text-center sm:mb-16">
      <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">Pensado para comercios que necesitan ordenarse</h2>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-muted-foreground sm:text-base">Cada rubro tiene sus reglas. Nosotros las conocemos.</p>
    </div>

    <div class="relative mx-auto aspect-square w-full max-w-[340px] sm:max-w-[520px]">
      <svg class="pointer-events-none absolute inset-0 h-full w-full" viewBox="0 0 100 100">
        <circle cx="50" cy="50" r={radius} fill="none" stroke="oklch(68% 0.14 290)" stroke-width="0.18" stroke-opacity="0.22" stroke-dasharray="1 1.4"></circle>
        <circle cx="50" cy="50" r="11" fill="none" stroke="oklch(68% 0.14 290)" stroke-width="0.22" stroke-opacity="0.18"></circle>
        <circle cx="50" cy="50" r="11" fill="oklch(68% 0.14 290 / 0.06)"></circle>
      </svg>

      <div class="rubros-ring absolute inset-0">
        <svg class="pointer-events-none absolute inset-0 h-full w-full" viewBox="0 0 100 100">
          {starLines.map((line) => <line x1={line.x1} y1={line.y1} x2={line.x2} y2={line.y2} stroke="oklch(68% 0.18 290)" stroke-width="0.3" stroke-opacity="0.22"></line>)}
          {positions.map((position) => <line x1="50" y1="50" x2={position.x} y2={position.y} stroke="oklch(68% 0.18 290)" stroke-width="0.18" stroke-opacity="0.16" stroke-dasharray="1.2 0.8"></line>)}
        </svg>

        {rubros.map((rubro, index) => (
          <div class="absolute" style={`left: ${positions[index].x}%; top: ${positions[index].y}%`}>
            <div class="rubros-node-inner group">
              <div class="flex w-[78px] select-none flex-col items-center gap-1 rounded-xl bg-card/80 px-2 py-2 ring-1 ring-border/50 backdrop-blur-sm transition-all duration-300 hover:scale-110 hover:bg-primary/12 hover:ring-primary/50 hover:shadow-xl hover:shadow-primary/20 sm:w-[112px] sm:gap-1.5 sm:rounded-2xl sm:px-3 sm:py-2.5">
                <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-primary/12 transition-colors duration-300 group-hover:bg-primary/22 sm:h-9 sm:w-9 sm:rounded-xl">
                  <Icon name={rubro.icon} class="h-3.5 w-3.5 text-primary sm:h-[18px] sm:w-[18px]" />
                </div>
                <span class="whitespace-nowrap text-center text-[10px] font-semibold leading-tight text-foreground/90 sm:text-[12px]">{rubro.label}</span>
                <span class="hidden text-center text-[10px] leading-snug text-muted-foreground group-hover:sm:block">{rubro.detail}</span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="pointer-events-none absolute left-1/2 top-1/2 z-30 -translate-x-1/2 -translate-y-1/2">
        <div class="flex flex-col items-center gap-1 rounded-xl bg-card/90 px-2.5 py-2 shadow-lg shadow-primary/10 ring-2 ring-primary/30 backdrop-blur-sm sm:rounded-2xl sm:px-4 sm:py-3">
          <AnimatedTentacleLogo class="h-6 w-6 sm:h-8 sm:w-8" />
          <span class="text-[7px] font-bold uppercase tracking-[0.18em] text-primary sm:text-[9px]">OctopusTrack</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes orbit-spin { to { transform: rotate(360deg); } }
  @keyframes counter-spin { to { transform: translate(-50%, -50%) rotate(-360deg); } }
  .rubros-ring { animation: orbit-spin 28s linear infinite; transform-origin: center; }
  .rubros-node-inner { animation: counter-spin 28s linear infinite; transform: translate(-50%, -50%); transform-origin: 50% 50%; }
  .rubros-ring:hover, .rubros-ring:hover .rubros-node-inner { animation-play-state: paused; }
</style>
