---
import Icon from '../Icon.astro';
import PurchaseButton from './PurchaseButton.astro';
---

<section id="inicio" data-of-grid-hero class="relative overflow-hidden bg-background px-4 pb-20 pt-24 sm:px-6 sm:pt-32 lg:pb-28">
  <div data-of-grid-backdrop aria-hidden="true" class="pointer-events-none absolute inset-0 z-0 overflow-hidden [--grid-mask-x:50%] [--grid-mask-y:35%]">
    <div class="infinite-grid-drift absolute inset-0 text-primary-700 opacity-[0.08]" style="background-image: linear-gradient(to right, currentColor 1px, transparent 1px), linear-gradient(to bottom, currentColor 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="infinite-grid-drift absolute inset-0 text-primary-300 opacity-45" style="background-image: linear-gradient(to right, currentColor 1px, transparent 1px), linear-gradient(to bottom, currentColor 1px, transparent 1px); background-size: 40px 40px; mask-image: radial-gradient(320px circle at var(--grid-mask-x, 50%) var(--grid-mask-y, 35%), black, transparent 72%); -webkit-mask-image: radial-gradient(320px circle at var(--grid-mask-x, 50%) var(--grid-mask-y, 35%), black, transparent 72%);"></div>
    <div class="absolute inset-0"><div class="absolute right-[-18%] top-[-20%] h-[42%] w-[42%] rounded-full bg-primary-500/30 blur-[120px]"></div><div class="absolute right-[8%] top-[-8%] h-[22%] w-[22%] rounded-full bg-primary-700/24 blur-[96px]"></div><div class="absolute bottom-[-22%] left-[-12%] h-[44%] w-[44%] rounded-full bg-primary-300/24 blur-[130px]"></div></div>
  </div>

  <div class="relative z-10 mx-auto max-w-5xl animate-fade-in-up text-center">
    <p class="text-sm font-semibold tracking-wide text-primary">Para profesionales independientes</p>
    <h1 class="mx-auto mt-5 max-w-4xl font-display text-[44px] font-black leading-[1.02] tracking-tight text-foreground sm:text-6xl lg:text-[82px]">Presupuestos que <span class="text-primary">cierran ventas</span></h1>
    <p class="mx-auto mt-8 max-w-3xl text-xl leading-relaxed text-muted-foreground sm:text-2xl">Creá, compartí y gestioná presupuestos profesionales desde tu celular. Envialos por WhatsApp al instante.</p>
    <p class="mx-auto mt-2 max-w-3xl text-lg leading-relaxed text-muted-foreground/85 sm:text-xl">Sin planillas, sin papeles, sin perder clientes.</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <PurchaseButton source="octopusflow-hero" className="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-8 py-4 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/30 transition-all duration-200 hover:scale-[1.02] hover:bg-primary/90">
        Obtener OctopusFlow
        <Icon name="arrowRight" class="h-5 w-5" />
      </PurchaseButton>
    </div>
  </div>

  <div class="relative z-10 mx-auto mt-10 w-full max-w-[1180px] sm:mt-14 lg:mt-16">
    <div class="pointer-events-none absolute inset-x-12 -top-8 h-24 rounded-full bg-primary-500/20 blur-[70px]"></div>
    <img src="/assets/dashboard-2.webp" alt="Panel de OctopusFlow en escritorio" class="relative mx-auto w-full rounded-[28px] shadow-2xl shadow-background/60 ring-1 ring-border/80" loading="eager" />
  </div>
</section>

<script>
  const ofHero = document.querySelector<HTMLElement>('[data-of-grid-hero]');
  const ofBackdrop = document.querySelector<HTMLElement>('[data-of-grid-backdrop]');
  if (ofHero && ofBackdrop) {
    ofHero.addEventListener('mousemove', (event) => {
      const rect = ofHero.getBoundingClientRect();
      ofBackdrop.style.setProperty('--grid-mask-x', `${event.clientX - rect.left}px`);
      ofBackdrop.style.setProperty('--grid-mask-y', `${event.clientY - rect.top}px`);
    });
    ofHero.addEventListener('mouseleave', () => {
      ofBackdrop.style.setProperty('--grid-mask-x', '50%');
      ofBackdrop.style.setProperty('--grid-mask-y', '35%');
    });
  }
</script>
