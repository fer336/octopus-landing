---
import Header from './Header.astro';
import Hero from './Hero.astro';
import PainPoints from './PainPoints.astro';
import CounterSalesSection from './CounterSalesSection.astro';
import MarqueeTicker from './MarqueeTicker.astro';
import SectionDivider from './SectionDivider.astro';
import OctopusTrackShowcase from './OctopusTrackShowcase.astro';
import BigTextBanner from './BigTextBanner.astro';
import SocialProof from './SocialProof.astro';
import OctopusFlowCrossSell from './OctopusFlowCrossSell.astro';
import FaqSection from './FaqSection.astro';
import ContactForm from './ContactForm.astro';
import Footer from './Footer.astro';
import FloatingContactButton from './FloatingContactButton.astro';
import DemoModal from './DemoModal.astro';
import Icon from './Icon.astro';

const WHATSAPP_URL = 'https://wa.me/5492254596618';
const ASSET_WEBHOOK_URL = import.meta.env.VITE_LANDING_ASSET_WEBHOOK_URL || '#webhook-no-configured';
const buildAssetWebhookUrl = (format: 'excel' | 'sheets') => {
  if (!ASSET_WEBHOOK_URL || ASSET_WEBHOOK_URL.startsWith('#')) return ASSET_WEBHOOK_URL;
  const separator = ASSET_WEBHOOK_URL.includes('?') ? '&' : '?';
  return `${ASSET_WEBHOOK_URL}${separator}format=${format}`;
};
const industriasTicker = ['Ferreterías', 'Distribuidoras', 'Forrajerías', 'Sanitarios', 'Electricidad'];
---

<div class="min-h-screen bg-background text-foreground">
  <div data-thank-you-page class="hidden min-h-screen bg-background text-foreground">
    <div class="mx-auto flex min-h-screen w-full max-w-4xl items-center px-4 py-12 sm:px-6">
      <section class="w-full rounded-3xl bg-card/80 p-8 text-center shadow-2xl ring-1 ring-border">
        <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-primary/20">
          <Icon name="checkCircle" class="h-8 w-8 text-primary" />
        </div>
        <p class="text-sm font-semibold uppercase tracking-widest text-primary">Pago confirmado</p>
        <h1 class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">Tu cotizador ya está listo</h1>
        <p class="mx-auto mt-4 max-w-lg text-base text-muted-foreground">Acá tenés acceso inmediato al archivo Excel y Google Sheets. Descargalo y empezá a usar tu nuevo cotizador.</p>
        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          <a href={buildAssetWebhookUrl('excel')} target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-4 py-3 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">
            Descargar Excel
            <Icon name="arrowRight" class="h-4 w-4" />
          </a>
          <a href={buildAssetWebhookUrl('sheets')} target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-border bg-transparent px-4 py-3 text-sm font-medium text-foreground transition-colors hover:bg-accent hover:text-accent-foreground">
            Obtener Google Sheets
            <Icon name="arrowRight" class="h-4 w-4" />
          </a>
        </div>
        <div class="mt-10 rounded-xl bg-muted/40 p-4">
          <p class="text-sm text-muted-foreground">¿Necesitás ayuda? <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="text-primary underline hover:text-primary/80">Escribinos por WhatsApp</a></p>
        </div>
      </section>
    </div>
  </div>

  <div data-landing-content>
    <Header />
    <FloatingContactButton />
    <main>
      <Hero />
      <SectionDivider from="transparent" to="rgb(var(--background))" />
      <PainPoints />
      <CounterSalesSection />
      <MarqueeTicker items={industriasTicker} duration={42} />
      <SectionDivider from="transparent" to="rgb(var(--background))" />
      <OctopusTrackShowcase />
      <BigTextBanner />
      <MarqueeTicker items={['Stock', 'Ventas', 'Facturación ARCA', 'Cuentas corrientes', 'Listas de precio', 'Acopios', 'Órdenes de compra']} duration={28} reversed />
      <SectionDivider from="rgb(var(--background))" to="rgb(var(--background))" />
      <SocialProof />
      <SectionDivider from="transparent" to="rgb(var(--background))" />
      <section id="precios" class="relative overflow-hidden bg-background px-4 py-20 sm:px-6 sm:py-28">
        <div class="section-container">
          <div class="reveal-on-scroll overflow-hidden rounded-[28px] border border-primary/20 bg-card shadow-2xl shadow-primary/10 md:grid md:grid-cols-[0.92fr_1.08fr]">
            <div class="relative overflow-hidden bg-primary px-6 py-10 text-primary-foreground sm:px-10 sm:py-14 lg:px-12 lg:py-16">
              <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-primary-foreground/15 blur-3xl"></div>
              <div class="pointer-events-none absolute -bottom-24 left-8 h-56 w-56 rounded-full bg-background/20 blur-3xl"></div>
              <div class="relative">
                <p class="text-[11px] font-bold uppercase tracking-[0.32em] text-primary-foreground/70">Demo guiada</p>
                <h2 class="mt-5 max-w-xl font-display text-4xl font-black leading-[0.98] tracking-tight sm:text-5xl lg:text-6xl">Empezá en minutos. Sin complicaciones.</h2>
              </div>
            </div>
            <div class="bg-card px-6 py-10 sm:px-10 sm:py-14 lg:px-12 lg:py-16">
              <p class="max-w-xl text-lg leading-relaxed text-foreground sm:text-xl">Te mostramos cómo ordenar stock, ventas, listas de precio, cuentas corrientes y facturación sin cambiar la forma en que trabaja tu comercio.</p>
              <div class="mt-8 grid gap-3 text-sm text-muted-foreground sm:grid-cols-2">
                {['Sin tarjeta', 'Sin contratos largos', 'Acompañamiento real', 'Configurado para tu rubro'].map((item) => (
                  <div class="flex items-center gap-2.5"><Icon name="checkCircle" class="h-4 w-4 shrink-0 text-primary" /><span>{item}</span></div>
                ))}
              </div>
              <div class="mt-10 flex flex-col gap-3 sm:flex-row">
                <button type="button" data-open-demo-modal class="group relative isolate inline-flex touch-none items-center justify-center gap-2 overflow-visible rounded-xl bg-primary px-6 py-3.5 text-sm font-semibold text-primary-foreground transition-all duration-200 hover:scale-[1.02] hover:bg-primary/90 sm:min-w-[210px]">
                  <span class="pointer-events-none absolute left-1/2 top-1/2 -z-10 block h-full w-full -translate-x-1/2 -translate-y-1/2 rounded-[inherit] bg-primary/35 opacity-0 blur-xl transition-opacity duration-300 group-hover:opacity-70"></span>
                  <Icon name="magnet" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-6 group-hover:scale-110" />
                  Probar demo
                </button>
                <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 rounded-xl border border-border bg-background/40 px-6 py-3.5 text-sm font-medium text-foreground transition-all duration-200 hover:bg-background">
                  Hablar por WhatsApp
                  <Icon name="messageCircle" class="h-4 w-4" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
      <OctopusFlowCrossSell />
      <FaqSection />
      <ContactForm />
    </main>
    <Footer />
    <DemoModal productType="octopustrack" productName="OctopusTrack" />
  </div>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const params = new URLSearchParams(window.location.search);
  const isThankYou = params.get('purchase') === 'success' || params.get('status') === 'success' || params.get('payment') === 'success' || params.get('mp_status') === 'approved';
  if (isThankYou) {
    document.querySelector<HTMLElement>('[data-landing-content]')?.classList.add('hidden');
    document.querySelector<HTMLElement>('[data-thank-you-page]')?.classList.remove('hidden');
  }

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.registerPlugin(ScrollTrigger);
    document.querySelectorAll<HTMLElement>('.reveal-on-scroll').forEach((element) => {
      const rawDelay = element.style.getPropertyValue('--reveal-delay') || getComputedStyle(element).getPropertyValue('--reveal-delay') || '0';
      gsap.fromTo(element, { opacity: 0, y: 36, filter: 'blur(6px)' }, { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.85, delay: parseFloat(rawDelay) / 1000, ease: 'power3.out', scrollTrigger: { trigger: element, start: 'top 88%', once: true } });
    });

    document.querySelectorAll<HTMLElement>('[data-tilt-card]').forEach((card) => {
      let frame = 0;
      const strength = Number(card.dataset.tiltStrength ?? '10');
      card.addEventListener('mousemove', (event) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const rect = card.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width - 0.5;
          const y = (event.clientY - rect.top) / rect.height - 0.5;
          card.style.transform = `perspective(1000px) rotateY(${x * strength}deg) rotateX(${-y * strength}deg) translateZ(6px)`;
        });
      });
      card.addEventListener('mouseenter', () => card.style.transition = 'transform 0.08s linear, box-shadow 0.3s ease');
      card.addEventListener('mouseleave', () => {
        cancelAnimationFrame(frame);
        card.style.transition = 'transform 0.55s cubic-bezier(0.23, 1, 0.32, 1), box-shadow 0.4s ease';
        card.style.transform = '';
      });
    });
  }
</script>
