---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingRoot from '../components/LandingRoot.astro';
import ScrollProgressBar from '../components/ScrollProgressBar.astro';
import { homeFaqItems } from '../data/homeFaq';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'OctopusTrack',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description:
      'ERP para ferreterías, distribuidoras, sanitarios y casas de electricidad que necesitan vender rápido, controlar stock, facturar con ARCA, manejar caja, cuentas corrientes, listas de precios y reportes desde una plataforma simple y fácil de aprender.',
    url: 'https://octopustrack.shop',
    publisher: {
      '@type': 'Organization',
      name: 'OctopusTrack',
      url: 'https://octopustrack.shop',
    },
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      priceCurrency: 'ARS',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'OctopusTrack',
    url: 'https://octopustrack.shop',
    logo: 'https://octopustrack.shop/images/og/og-image-1200x630.jpg',
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer service',
      availableLanguage: 'Spanish',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<BaseLayout
  title="ERP para Ferreterías, Distribuidoras y Comercios con Facturación ARCA | OctopusTrack"
  description="ERP para ferreterías, distribuidoras, sanitarios y casas de electricidad: vendé rápido, controlá stock, facturación ARCA, caja, cuentas corrientes, listas de precios y reportes desde un sistema simple."
  canonicalUrl="https://octopustrack.shop/"
  structuredData={structuredData}
>
  <ScrollProgressBar />
  <LandingRoot />
  <script>
    const visitorWebhookUrl = import.meta.env.VITE_VISITOR_WEBHOOK_URL || '';
    if (visitorWebhookUrl && !visitorWebhookUrl.startsWith('#')) {
      const search = new URLSearchParams(window.location.search);
      const query = new URLSearchParams({
        page_url: window.location.href,
        referrer: document.referrer || '',
        utm_source: search.get('utm_source') || '',
        utm_medium: search.get('utm_medium') || '',
        utm_campaign: search.get('utm_campaign') || '',
        visited_at: new Date().toISOString(),
      });
      fetch(`${visitorWebhookUrl}?${query.toString()}`).catch(() => {});
    }
  </script>
</BaseLayout>
