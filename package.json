{
  "name": "octopustrack-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host --port 5175 --strictPort --open /landing.html",
    "build": "tsc && vite build --config vite.config.ts --outDir dist-landing --emptyOutDir && cp src/landing/sitemap.xml dist-landing/ && cp src/landing/robots.txt dist-landing/ && cp -r public/images dist-landing/",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host --port 4175"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "clsx": "^2.1.0",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.359.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.3",
    "vite": "^5.2.6"
  }
}
